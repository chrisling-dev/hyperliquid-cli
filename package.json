{
  "name": "hyperliquid-cli",
  "version": "1.0.0-beta.1",
  "description": "CLI tool for Hyperliquid DEX",
  "author": "Chris Ling",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisling-dev/hyperliquid-cli.git"
  },
  "homepage": "https://github.com/chrisling-dev/hyperliquid-cli#readme",
  "bugs": {
    "url": "https://github.com/chrisling-dev/hyperliquid-cli/issues"
  },
  "keywords": [
    "hyperliquid",
    "cli",
    "dex",
    "trading",
    "perpetuals",
    "crypto"
  ],
  "type": "module",
  "bin": {
    "hl": "./dist/index.js",
    "hl-core": "./dist/core/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "SKILLS.md",
    "api-docs-snapshot.json",
    "api-manifest.json"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "pnpm build",
    "api:manifest": "tsx scripts/api-manifest.ts",
    "api:audit": "tsx src/index.ts api audit"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.2.0",
    "@nktkas/hyperliquid": "0.33.3",
    "better-sqlite3": "^12.6.2",
    "commander": "^12.1.0",
    "valibot": "1.5.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.2",
    "globals": "^17.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c",
  "publishConfig": {
    "tag": "beta"
  }
}
